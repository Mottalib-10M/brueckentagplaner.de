---
import PageLayout from '../../layouts/PageLayout.astro';
import { CONTACT_EMAIL, SITE_NAMES } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { contactPageSchema } from '../../lib/seo';
const lang = 'de';
const description = 'Schreiben Sie uns, wenn ein Feiertag, ein Datum oder eine Gemeinde nicht stimmt, oder wenn Sie den Brückentage-Rechner auf Ihrer Seite einbinden möchten.';
---
<PageLayout title={`Kontakt zu ${SITE_NAMES[lang]}: Fehler melden, Rechner einbinden`} description={description} lang={lang} noindex={true} jsonLd={[contactPageSchema({ name: 'Kontakt', description, path: route('contact', lang), lang })]} breadcrumbs={[{ label: 'Kontakt' }]} showAuthor={false}>
  <div class="prose prose-slate max-w-none">
    <h1>Kontakt</h1>
    <p>E-Mail: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. Antwort meist innerhalb einer Woche.</p>
    <h2>Ein Feiertag oder Datum scheint falsch</h2>
    <p>Nennen Sie die Seite, das Land, das Jahr und, wenn möglich, die Fundstelle im Feiertagsgesetz oder in der Verordnung Ihres Landes. Wir prüfen an der Quelle und korrigieren innerhalb weniger Tage.</p>
    <h2>Ihre Gemeinde fehlt oder ist falsch eingeordnet</h2>
    <p>Für Bayern nutzen wir die Liste des Landesamts für Statistik zu Mariä Himmelfahrt, für Sachsen die Fronleichnamsverordnung. Wenn Ihre Gemeinde fehlt oder anders feiert, schreiben Sie uns den genauen Namen und den Landkreis.</p>
    <h2>Rechner einbinden</h2>
    <p>Betriebsräte, Personalabteilungen, Vereine und Lokalzeitungen können den Brückentage-Optimierer und die Feiertagsliste kostenlos einbinden: <a href={route('widget', lang)}>Einbinden</a>.</p>
    <h2>Was wir nicht leisten</h2>
    <p>Keine Rechtsberatung zu Urlaubsanträgen, keine Auskunft zu Schulferien und keine Reisebuchung.</p>
  </div>
</PageLayout>
