---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = (name: string, t: string, h: number) => `<iframe src="${SITE_URL}/embed/${lang}/${name}/" title="${t}" width="100%" height="${h}" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
const items = [
  { name: 'brueckentage-optimierer', h2: 'Bridge-day planner', text: 'State, year and leave days: your readers see the best plan and every bridge of the year.', t: 'Bridge-day planner for Germany', h: 980 },
  { name: 'feiertage', h2: 'Public holidays by state', text: 'The statutory public holidays of each German state for 2026 to 2028, with weekday and partial holidays.', t: 'German public holidays by state', h: 900 },
];
---
<PageLayout title="Embed the bridge-day planner for free: planner and holidays" description="Embed the German bridge-day planner and public holiday list for free with an iframe: copy the code, and new years and changed holidays appear on your site by themselves." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the bridge-day planner</h1>
    <p class="mt-3 text-lg text-navy-700">For works councils, HR teams, clubs and local newspapers: copy once, new years appear by themselves.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    {items.map((i) => (<>
      <h2>{i.h2}</h2>
      <p>{i.text}</p>
      <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code(i.name, i.t, i.h)}</code></pre>
    </>))}
    <p>For the German version, replace <code>/embed/en/</code> with <code>/embed/de/</code>. Terms: the source link under the planner stays visible, the planner is not altered and is provided without warranty. What your readers enter stays on their device. Questions through the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/${lang}/brueckentage-optimierer/`} title="Bridge-day planner for Germany" width="100%" height="980" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
